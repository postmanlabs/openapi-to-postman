{
  "openapi": "3.0.3",
  "info": {
    "title": "Binary Request Body via $ref - OpenAPI 3.0",
    "version": "1.0.0"
  },
  "paths": {
    "/uploadFile": {
      "post": {
        "summary": "uploads a file",
        "operationId": "uploadFile",
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "$ref": "#/components/schemas/RequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestBody": {
        "type": "string",
        "format": "binary",
        "description": "The file to be uploaded."
      }
    }
  }
}
